---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Layers from '../components/Layers.astro';
import Specifiers from '../components/Specifiers.astro';
import PatternSelector from '../components/PatternSelector.astro';
import Simulator from '../components/Simulator.astro';
import Textures from '../components/Textures.astro';
import Sample from '../components/Sample.astro';
import Gallery from '../components/Gallery.astro';
import Install from '../components/Install.astro';
import Trust from '../components/Trust.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { config } from '../config';

const pageCfg = { whatsapp: config.whatsappNumber, campaign: config.campaignCode, gtmId: config.gtmId };
---

<Base
  title="Timberland SPC: piso vinílico rígido com beleza de madeira | Belgotex"
  description="Piso vinílico SPC à prova d'água, com base acústica IXPE e instalação clic sem cola. 7 padrões de carvalho em 3 formatos. Solicite sua cotação à Belgotex."
>
  <Header />
  <main id="conteudo">
    <Hero />
    <Trust />
    <Layers />
    <Specifiers />
    <PatternSelector />
    <Simulator />
    <Textures />
    <Sample />
    <Gallery />
    <Install />
    <Faq />
  </main>
  <Footer />
  <StickyBar />
  <WhatsAppFab />
  <ConsentBanner />
  <div data-page-config data-config={JSON.stringify(pageCfg)} hidden></div>
</Base>

<script>
  import { initPage } from '../scripts/main';
  const el = document.querySelector<HTMLElement>('[data-page-config]');
  initPage(JSON.parse(el?.dataset.config ?? '{}'));
</script>
