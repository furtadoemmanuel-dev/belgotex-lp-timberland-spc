---
import QuoteLink from './QuoteLink.astro';
/**
 * Anatomia da régua: vista explodida das 5 camadas, na ordem do catálogo do fabricante
 * (cat_timberland.pdf, p. 9): Excimer, camada de desgaste, textura sincronizada, núcleo de alta densidade e IXPE.
 * Espessuras citadas só onde a ficha técnica confirma: capa de uso 0,50 mm, IXPE 1 mm, total 5 mm (régua padrão e HB).
 * O XL (catálogo p. 67) tem 6,5 mm (5,5 mm + 1 mm IXPE) e capa de uso de 0,55 mm: citado no texto, o desenho segue a régua padrão.
 * Espessuras do desenho proporcionais entre si (MM unidades por mm): capa de uso 0,50 mm, núcleo ≈ 3,5 mm
 * (4 mm de piso menos as películas), IXPE 1 mm. Acabamento e película decorativa não têm espessura na ficha:
 * entram como películas finíssimas (linha de luz). A espessura é ampliada em relação ao comprimento da régua.
 */
import { getImage } from 'astro:assets';
import decorSrc from '../assets/layers/decor-canyon-oak.jpg';
import versoSrc from '../assets/product/verso-ixpe.jpg'; // foto do produto, catálogo p. 8

const decor = await getImage({ src: decorSrc, width: 694, format: 'webp', quality: 78 });
const verso = await getImage({ src: versoSrc, width: 732, format: 'webp', quality: 78 });

type P = [number, number];
const add = (a: P, b: P): P => [a[0] + b[0], a[1] + b[1]];
const pts = (...p: P[]) => p.map((q) => q.map((v) => +v.toFixed(1)).join(',')).join(' ');

// Eixos da vista: L = comprimento da régua, W = profundidade
const O: P = [70, 175];
const L: P = [470, 118];
const W: P = [128, -125];
const GAP = 62;
const MM = 6; // unidades por milímetro
const FILM = 0.6; // películas sem espessura informada

const layers = [
  {
    n: 1,
    t: FILM,
    title: 'Acabamento Excimer + PureCoat',
    fact: 'UV · PUR',
    text: 'Fosco e sem reflexo, criado com luz ultravioleta. O tratamento PureCoat protege contra arranhões e facilita a limpeza.',
  },
  {
    n: 2,
    t: 0.5 * MM,
    title: 'Camada de uso',
    fact: '0,50 mm',
    text: 'Película transparente e resistente à abrasão. É ela que protege o desenho da madeira do desgaste do dia a dia. No grande formato (XL), tem 0,55 mm.',
  },
  {
    n: 3,
    t: FILM,
    title: 'Textura sincronizada (EIR)',
    fact: 'Alta definição',
    text: 'O desenho da madeira, impresso em alta definição, com relevo que acompanha os veios: você vê e sente a madeira.',
  },
  {
    n: 4,
    t: 3.5 * MM,
    title: 'Núcleo SPC de alta densidade',
    fact: '100% à prova d’água',
    text: 'Núcleo mineral rígido que dá estabilidade à régua e onde fica o encaixe clic, sem cola.',
  },
  {
    n: 5,
    t: 1 * MM,
    title: 'Base acústica IXPE',
    fact: '1 mm · Δ 18 dB',
    text: 'Espuma já incorporada à régua: reduz o ruído de impacto e protege contra a umidade nas conexões.',
  },
];

let cum = 0;
const slabs = layers.map((l, i) => {
  const y = cum;
  cum += l.t;
  const d: P = [0, l.t];
  const a = O;
  const b = add(O, L);
  const c = add(b, W);
  const e = add(O, W);
  const mid = add(add(b, [W[0] / 2, W[1] / 2]), [0, l.t / 2]);
  return {
    ...l,
    asY: y + (GAP * 4) / 2,
    exY: y + i * GAP,
    top: pts(a, b, c, e),
    front: pts(a, b, add(b, d), add(a, d)),
    side: pts(b, c, add(c, d), add(b, d)),
    // perfil do encaixe clic na ponta da régua (lingueta no meio da espessura)
    groove: [add(b, [0, l.t * 0.45]), add(c, [0, l.t * 0.45])] as P[],
    edge: [add(O, [0, l.t]), add(b, [0, l.t])] as P[],
    anchor: mid,
  };
});
const total = cum;
// Matriz que leva a imagem (694 × 256) para a face de cima
const [iw, ih] = [694, 256];
const imgMatrix = `matrix(${L[0] / iw} ${L[1] / iw} ${W[0] / ih} ${W[1] / ih} ${O[0]} ${O[1]})`;
const ord = (n: number) => String(n).padStart(2, '0');
---

<section id="camadas" class="ly-sec" data-section-id="layers" aria-labelledby="camadas-title">
  <div class="container">
    <div class="ly-head">
      <p class="eyebrow ly-eyebrow">Anatomia da régua</p>
      <h2 id="camadas-title">Cinco camadas, cada uma com uma função.</h2>
      <p class="lead ly-lead">
        Do acabamento à base acústica, cada camada tem uma função. Toque numa camada do desenho ou passe o
        mouse na lista para ver onde ela fica.
      </p>
    </div>

    <div class="ly" data-layers data-state="exploded">
      <figure class="ly-figure">
        <svg viewBox="-30 30 770 560" role="img" aria-labelledby="ly-svg-title ly-svg-desc" class="ly-svg">
          <title id="ly-svg-title">Vista explodida da régua Timberland</title>
          <desc id="ly-svg-desc">
            De cima para baixo: 1, acabamento Excimer com PureCoat; 2, camada de uso de 0,50 milímetro; 3,
            textura sincronizada com o desenho da madeira; 4, núcleo SPC de alta densidade; 5, base acústica
            IXPE de 1 milímetro. Total de 5 milímetros na régua Regular; 6,5 milímetros no grande formato.
          </desc>
          <defs>
            <linearGradient
              id="ly-gloss"
              gradientUnits="userSpaceOnUse"
              x1={O[0]}
              y1={O[1]}
              x2={O[0] + L[0] + W[0]}
              y2={O[1] + L[1] + W[1]}
            >
              <stop offset="0" stop-color="#fff" stop-opacity="0.22"></stop>
              <stop offset="0.42" stop-color="#fff" stop-opacity="0.03"></stop>
              <stop offset="0.58" stop-color="#fff" stop-opacity="0.14"></stop>
              <stop offset="1" stop-color="#fff" stop-opacity="0.02"></stop>
            </linearGradient>
            <linearGradient
              id="ly-core-top"
              gradientUnits="userSpaceOnUse"
              x1={O[0]}
              y1="0"
              x2={O[0] + L[0] + W[0]}
              y2="0"
            >
              <stop offset="0" stop-color="#a3a6aa"></stop>
              <stop offset="1" stop-color="#83868a"></stop>
            </linearGradient>
            <linearGradient id="ly-core-front" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#6f7276"></stop>
              <stop offset="1" stop-color="#55585c"></stop>
            </linearGradient>
            <pattern id="ly-foam" width="4" height="4" patternUnits="userSpaceOnUse">
              <rect width="4" height="4" fill="#8b8f93"></rect>
              <circle cx="1" cy="1" r="0.45" fill="#a2a6aa"></circle>
              <circle cx="3" cy="2.6" r="0.5" fill="#7c8084"></circle>
            </pattern>
            <filter id="ly-soft" x="-10%" y="-40%" width="120%" height="180%">
              <feGaussianBlur stdDeviation="10"></feGaussianBlur>
            </filter>
          </defs>

          <!-- Cota de espessura (aparece com a régua montada) -->
          <g class="ly-dim" aria-hidden="true" transform={`translate(0 ${(GAP * 4) / 2})`}>
            <path
              d={`M44 ${O[1]}h-12M38 ${O[1]}v${total}M44 ${O[1] + total}h-12`}
              stroke="#fff"
              stroke-width="1"
              fill="none"
            ></path>
            <text x="22" y={O[1] + total / 2 + 7} text-anchor="end" class="ly-dim-text">
              5 mm
            </text>
          </g>

          {[...slabs].reverse().map((s) => (
            <g class="ly-layer" data-layer={s.n} style={`--i:${s.n};--as:${s.asY}px;--ex:${s.exY}px`}>
              {s.n === 1 ? (
                <>
                  <polygon points={s.top} fill="url(#ly-gloss)" />
                  <line
                    class="ly-hair"
                    x1={s.edge[0]![0]}
                    y1={s.edge[0]![1]}
                    x2={s.edge[1]![0]}
                    y2={s.edge[1]![1]}
                  />
                </>
              ) : s.n === 2 ? (
                <>
                  <polygon points={s.front} fill="#fff" fill-opacity="0.26" />
                  <polygon points={s.side} fill="#fff" fill-opacity="0.16" />
                  <polygon points={s.top} fill="url(#ly-gloss)" />
                  <polygon points={s.top} fill="#fff" fill-opacity="0.05" />
                </>
              ) : s.n === 3 ? (
                <>
                  <image
                    href={decor.src}
                    width={iw}
                    height={ih}
                    preserveAspectRatio="none"
                    transform={imgMatrix}
                  />
                  <line
                    x1={s.edge[0]![0]}
                    y1={s.edge[0]![1]}
                    x2={s.edge[1]![0]}
                    y2={s.edge[1]![1]}
                    stroke="#8a6a49"
                    stroke-width="1.2"
                  />
                </>
              ) : s.n === 4 ? (
                <>
                  <polygon points={s.front} fill="url(#ly-core-front)" />
                  <polygon points={s.side} fill="#4f5256" />
                  <polygon points={s.top} fill="url(#ly-core-top)" />
                  <line
                    x1={s.groove[0]![0]}
                    y1={s.groove[0]![1]}
                    x2={s.groove[1]![0]}
                    y2={s.groove[1]![1]}
                    stroke="#2f3235"
                    stroke-width="1.6"
                  />
                </>
              ) : (
                <>
                  <polygon
                    points={s.top}
                    fill="#000"
                    fill-opacity="0.45"
                    filter="url(#ly-soft)"
                    transform="translate(0 26)"
                  />
                  <polygon points={s.front} fill="#6c7074" />
                  <polygon points={s.side} fill="#5c6064" />
                  <polygon points={s.top} fill="url(#ly-foam)" />
                </>
              )}
              <polygon class="ly-edge" points={s.top} />
              {s.t > 1 && <polygon class="ly-edge" points={s.front} />}
              {s.t > 1 && <polygon class="ly-edge" points={s.side} />}
              <g class="ly-marker" aria-hidden="true">
                <circle cx={s.anchor[0]} cy={s.anchor[1]} r="2.5" fill="#fff" />
                <path
                  d={`M${s.anchor[0]} ${s.anchor[1]}H${s.anchor[0] + 70}`}
                  stroke="#fff"
                  stroke-opacity="0.7"
                  stroke-width="0.8"
                />
                <circle cx={s.anchor[0] + 88} cy={s.anchor[1]} r="18" class="ly-badge" />
                <text x={s.anchor[0] + 88} y={s.anchor[1] + 6} text-anchor="middle" class="ly-num">
                  {s.n}
                </text>
              </g>
            </g>
          ))}
        </svg>
        <figcaption class="ly-cap">
          <button type="button" class="ly-toggle" data-layers-toggle aria-pressed="false">
            <span data-label-exploded>Ver a régua montada</span>
            <span data-label-assembled hidden>
              Ver as camadas separadas
            </span>
          </button>
          <span class="small ly-note">
            Visualização ilustrativa · espessuras proporcionais entre as camadas
          </span>
        </figcaption>
      </figure>

      <div class="ly-side">
        <ol class="ly-list">
          {layers.map((l) => (
            <li data-layer={l.n}>
              <button type="button" class="ly-item" data-layer-btn={l.n} aria-pressed="false">
                <span class="ly-item-num" aria-hidden="true">
                  {ord(l.n)}
                </span>
                <span class="ly-item-title">
                  <span class="sr-only">Destacar no desenho: </span>
                  {l.title}
                </span>
                <span class="ly-item-fact">{l.fact}</span>
              </button>
              <p class="ly-item-text">{l.text}</p>
            </li>
          ))}
        </ol>
        <p class="ly-total">
          <strong>5 mm no total</strong>
          <span>
            4 mm de piso + 1 mm de base acústica IXPE incorporada, nas réguas padrão e HB. No grande formato
            (XL): 6,5 mm, com 5,5 mm de piso.
          </span>
        </p>
        <figure class="ly-photo">
          <img
            src={verso.src}
            width={verso.attributes.width ?? 732}
            height={verso.attributes.height ?? 573}
            alt="Foto de duas réguas Timberland mostrando o verso e a borda, com a espuma da base acústica IXPE"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Foto real · verso das réguas, com a base acústica IXPE incorporada</figcaption>
        </figure>
        <div class="actions">
          <QuoteLink class="btn ly-btn" loc="layers">Solicitar cotação</QuoteLink>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ly-sec {
    background: radial-gradient(120% 80% at 30% 40%, #262a2f 0%, #17191c 60%), #17191c;
    color: #fff;
    padding-block: var(--space-section);
    overflow: hidden;
  }
  .ly-head {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .ly-eyebrow {
    color: rgba(255, 255, 255, 0.72);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .ly-eyebrow::before {
    content: '';
    width: 2.5rem;
    height: 1px;
    background: currentColor;
  }
  .ly-lead {
    color: rgba(255, 255, 255, 0.78);
  }

  .ly {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 960px) {
    .ly {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 1rem + 3vw, 4rem);
    }
  }
  .ly-figure {
    margin: 0;
  }
  @media (max-width: 599px) {
    .ly-svg {
      width: calc(100% + 2 * var(--gutter));
      margin-inline: calc(-1 * var(--gutter));
    }
  }
  .ly-svg {
    width: 100%;
    overflow: visible;
  }

  /* Camadas: separadas (padrão) ou montadas */
  .ly-layer {
    transform: translateY(var(--ex));
    transition:
      transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.3s ease;
    transition-delay: calc((5 - var(--i)) * 70ms), 0s;
    cursor: pointer;
  }
  .ly[data-state='assembled'] .ly-layer {
    transform: translateY(var(--as));
    transition-delay: calc(var(--i) * 50ms), 0s;
  }
  .ly-edge {
    fill: none;
    stroke: rgba(255, 255, 255, 0.32);
    stroke-width: 0.6;
    stroke-linejoin: round;
  }
  .ly-hair {
    stroke: #fff;
    stroke-opacity: 0.75;
    stroke-width: 0.9;
  }
  .ly-marker {
    transition: opacity 0.35s ease 0.5s;
  }
  .ly[data-state='assembled'] .ly-marker {
    opacity: 0;
    transition-delay: 0s;
  }
  .ly-badge {
    fill: #17191c;
    stroke: #fff;
    stroke-opacity: 0.85;
    stroke-width: 0.9;
  }
  .ly-num {
    fill: #fff;
    font: 500 17px var(--font-body);
  }
  .ly-dim {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .ly[data-state='assembled'] .ly-dim {
    opacity: 1;
    transition-delay: 0.7s;
  }
  .ly-dim-text {
    fill: #fff;
    font: 500 16px var(--font-body);
    letter-spacing: 0.02em;
  }

  /* Destaque de uma camada */
  .ly[data-active] .ly-layer {
    opacity: 0.25;
  }
  .ly[data-active] .ly-layer.is-active {
    opacity: 1;
    transform: translate(-10px, calc(var(--ex) - 4px));
  }
  .ly[data-active] .ly-layer.is-active .ly-badge {
    fill: #fff;
  }
  .ly[data-active] .ly-layer.is-active .ly-num {
    fill: #17191c;
  }

  .ly-cap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 1rem;
  }
  .ly-toggle {
    min-height: 44px;
    padding: 0 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
    background: none;
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: 600;
    cursor: pointer;
  }
  .ly-toggle:hover {
    border-color: #fff;
  }
  .ly-note {
    color: rgba(255, 255, 255, 0.6);
  }

  .ly-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .ly-list li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    padding-bottom: 0.9rem;
    transition: background-color 0.25s;
  }
  .ly-item {
    width: 100%;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.9rem 0 0.35rem;
    min-height: 44px;
    background: none;
    border: 0;
    color: #fff;
    text-align: left;
    cursor: pointer;
  }
  .ly-item-num {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .ly-item-title {
    font-weight: 600;
  }
  .ly-item-fact {
    font-size: var(--fs-sm);
    color: rgba(255, 255, 255, 0.85);
    white-space: nowrap;
  }
  .ly-item-text {
    margin-left: 3rem;
    font-size: var(--fs-sm);
    color: rgba(255, 255, 255, 0.7);
  }
  .ly-list li.is-active .ly-item-num,
  .ly-item:hover .ly-item-num {
    color: #fff;
  }
  .ly-list li.is-active {
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.07), transparent);
  }
  .ly-list li.is-active .ly-item-text {
    color: rgba(255, 255, 255, 0.9);
  }
  .ly-sec :focus-visible {
    outline-color: #fff;
  }

  .ly-total {
    display: grid;
    gap: 0.15rem;
    margin: 1.5rem 0;
  }
  .ly-total strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.1;
  }
  .ly-total span {
    color: rgba(255, 255, 255, 0.72);
    font-size: var(--fs-sm);
  }
  .ly-photo {
    margin: 0 0 1.75rem;
  }
  .ly-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 732 / 573;
    max-height: 260px;
    object-fit: cover;
    border-radius: 3px;
    filter: saturate(0.9);
  }
  .ly-photo figcaption {
    margin-top: 0.5rem;
    font-size: var(--fs-sm);
    color: rgba(255, 255, 255, 0.72);
  }
  :global(.ly-btn) {
    background: #fff;
    border-color: #fff;
    color: var(--ink);
  }
  :global(.ly-btn:hover) {
    background: var(--paper);
  }
  @media (max-width: 599px) {
    .ly-item-fact {
      grid-column: 2 / -1;
      white-space: normal;
    }
  }
</style>
