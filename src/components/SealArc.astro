---
/**
 * Vitrine dos selos numa fileira curva guiada pela rolagem (src/scripts/sealarc.ts).
 * Decorativa: os mesmos selos aparecem descritos nos cards expansivos de Trust.astro.
 * As setas nas laterais avançam a fileira um selo por clique, somando-se à rolagem.
 */
interface Props {
  seals: { src: string; label: string }[];
}
const { seals } = Astro.props;
---

<div class="sa-wrap">
  <div class="sa" data-sealarc data-seals={JSON.stringify(seals)} aria-hidden="true">
    <div class="sa-band" data-sealarc-band></div>
  </div>
  <button type="button" class="sa-btn sa-prev" data-sealarc-step="-1" aria-label="Selos anteriores">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
      <path d="M15 5l-7 7 7 7"></path>
    </svg>
  </button>
  <button type="button" class="sa-btn sa-next" data-sealarc-step="1" aria-label="Próximos selos">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
      <path d="M9 5l7 7-7 7"></path>
    </svg>
  </button>
</div>

<style>
  .sa-wrap {
    position: relative;
    margin: 0 0 clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  .sa {
    position: relative;
    height: clamp(280px, 200px + 11vw, 370px);
    overflow: hidden;
  }
  /* Setas nas laterais, sobre o degradê das pontas */
  .sa-btn {
    position: absolute;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: clamp(44px, 40px + 0.8vw, 52px);
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--white);
    color: var(--ink);
    box-shadow: 0 8px 20px -10px rgba(35, 31, 32, 0.45);
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      background 0.25s ease,
      color 0.25s ease,
      transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .sa-prev {
    left: var(--gutter);
  }
  .sa-next {
    right: var(--gutter);
  }
  .sa-btn svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sa-btn:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    .sa-btn:hover {
      background: var(--ink);
      color: var(--white);
    }
  }
  .sa-btn:active {
    transform: translateY(-50%) scale(0.94);
  }
  /* Celular: as setas ficam lado a lado logo abaixo da fileira, para não cobrir os selos */
  @media (max-width: 639px) {
    .sa-wrap {
      display: grid;
      grid-template-columns: 1fr auto auto 1fr;
      column-gap: 0.75rem;
    }
    .sa {
      grid-column: 1 / -1;
    }
    .sa-btn {
      position: static;
      transform: none;
      margin-top: -1.5rem;
    }
    .sa-prev {
      grid-column: 2;
    }
    .sa-next {
      grid-column: 3;
    }
    .sa-btn:active {
      transform: scale(0.94);
    }
  }
  .sa-band {
    position: absolute;
    inset: 0;
    perspective-origin: 50% 50%;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .sa[data-ready] .sa-band {
    opacity: 1;
  }
  .sa :global(.sa-tile) {
    position: absolute;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .sa :global(.sa-strip) {
    position: absolute;
    top: 0;
    overflow: hidden;
    backface-visibility: hidden;
  }
  .sa :global(.sa-card) {
    position: absolute;
    top: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    align-items: center;
    padding: 9% 8% 10%;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: inset 0 -18px 30px -24px rgba(35, 31, 32, 0.25);
  }
  .sa :global(.sa-card img) {
    width: 62%;
    aspect-ratio: 1;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .sa :global(.sa-card span) {
    min-height: 2.6em;
    font-size: 1em;
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
    color: var(--ink);
    display: flex;
    align-items: center;
  }
</style>
