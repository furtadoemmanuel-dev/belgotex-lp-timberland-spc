---
import { getImage } from 'astro:assets';
import WaLink from './WaLink.astro';
import { config } from '../config';
import { formats, patterns } from '../lib/data';
import { environmentImages } from '../lib/images';
import plankSrc from '../assets/layers/decor-canyon-oak.jpg';

// Fundo da seção (foto escurecida) e a textura das réguas da barra de progresso
const bg = await getImage({
  src: environmentImages['pacific-oak-hall']!,
  width: 1600,
  format: 'webp',
  quality: 55,
});
const plank = await getImage({ src: plankSrc, width: 480, format: 'webp', quality: 70 });

const UFS = [
  'AC',
  'AL',
  'AP',
  'AM',
  'BA',
  'CE',
  'DF',
  'ES',
  'GO',
  'MA',
  'MT',
  'MS',
  'MG',
  'PA',
  'PB',
  'PR',
  'PE',
  'PI',
  'RJ',
  'RN',
  'RS',
  'RO',
  'RR',
  'SC',
  'SP',
  'SE',
  'TO',
];
const consentText =
  'Concordo que a Belgotex use meus dados para responder a esta solicitação, conforme a Política de privacidade.';
---

<section id="cotacao" class="section lead-sec" data-section-id="form" aria-labelledby="cotacao-title">
  <img class="lead-bg" src={bg.src} alt="" width="1600" height="1067" loading="lazy" decoding="async" />
  <div class="container grid-12">
    <div class="form-aside">
      <p class="eyebrow aside-eyebrow">Cotação Timberland</p>
      <h2 id="cotacao-title">Peça sua cotação em 2 passos.</h2>
      <p class="lead aside-lead">
        Um consultor Belgotex responde com a cotação e a orientação técnica para o seu projeto.
      </p>
      <ul class="perks">
        <li>Atendimento direto da Belgotex</li>
        <li>
          <a
            href="#amostra"
            class="perk-link"
            data-sample-open
            data-cta="sample"
            data-cta-id="sample_form_aside"
            data-loc="form_aside"
          >
            Amostras pelo correio
          </a>
        </li>
        <li>Ajuda para escolher padrão e formato</li>
      </ul>
      <p class="aside-wa">
        Prefere conversar agora?
        <WaLink location="form_aside" class="aside-wa-link">
          Fale com um consultor
        </WaLink>
      </p>
    </div>

    <div class="form-card" data-form-card style={`--plank:url(${plank.src})`}>
      <form
        id="lead-form"
        novalidate
        data-lead-form
        data-endpoint={config.leadEndpoint}
        data-campaign={config.campaignCode}
        data-consent-text={consentText}
        aria-describedby="form-required-note"
      >
        <div class="progress" aria-hidden="true">
          <div class="pstep">
            <span class="plank-slot">
              <span class="plank on"></span>
            </span>
            <span class="pname">Contato</span>
          </div>
          <div class="pstep">
            <span class="plank-slot">
              <span class="plank" data-progress-2></span>
            </span>
            <span class="pname">Projeto</span>
          </div>
        </div>
        <p class="step-label small" data-step-label aria-live="polite">
          Etapa 1 de 2
        </p>
        <p id="form-required-note" class="sr-only">
          Todos os campos são obrigatórios, exceto quando indicado como opcional.
        </p>

        <div class="hp" aria-hidden="true">
          <label for="f-website">Não preencha este campo</label>
          <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <fieldset class="step" data-step="1">
          <legend class="sr-only">Seus dados de contato</legend>
          <div class="field">
            <label for="f-name">Nome</label>
            <input
              id="f-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              aria-describedby="e-name"
            />
            <p class="err" id="e-name" data-error-for="name"></p>
          </div>
          <div class="field">
            <label for="f-phone">WhatsApp ou telefone</label>
            <input
              id="f-phone"
              name="phone"
              type="tel"
              inputmode="tel"
              autocomplete="tel-national"
              placeholder="(00) 00000-0000"
              required
              aria-describedby="e-phone"
            />
            <p class="err" id="e-phone" data-error-for="phone"></p>
          </div>
          <div class="field">
            <label for="f-profile">Você é</label>
            <select id="f-profile" name="profile" required aria-describedby="e-profile">
              <option value="">Selecione</option>
              <option value="consumidor">Consumidor</option>
              <option value="arquiteto-designer">Arquiteto ou designer</option>
              <option value="construtora-incorporadora">Construtora ou incorporadora</option>
              <option value="revenda">Revenda</option>
            </select>
            <p class="err" id="e-profile" data-error-for="profile"></p>
          </div>
          <button type="button" class="btn btn--primary full" data-next>
            Continuar
          </button>
        </fieldset>

        <fieldset class="step" data-step="2" hidden>
          <legend class="sr-only">Detalhes da solicitação</legend>
          <div class="field">
            <label for="f-email">E-mail</label>
            <input
              id="f-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              aria-describedby="e-email"
            />
            <p class="err" id="e-email" data-error-for="email"></p>
          </div>
          <div class="row-2">
            <div class="field">
              <label for="f-city">Cidade</label>
              <input
                id="f-city"
                name="city"
                type="text"
                autocomplete="address-level2"
                required
                aria-describedby="e-city"
              />
              <p class="err" id="e-city" data-error-for="city"></p>
            </div>
            <div class="field">
              <label for="f-uf">UF</label>
              <select id="f-uf" name="uf" autocomplete="address-level1" required aria-describedby="e-uf">
                <option value="">—</option>
                {UFS.map((uf) => (
                  <option value={uf}>{uf}</option>
                ))}
              </select>
              <p class="err" id="e-uf" data-error-for="uf"></p>
            </div>
          </div>
          <details class="more" data-more>
            <summary>
              Detalhes do projeto <span class="opt">(opcional)</span>
              <span class="more-hint" data-more-hint></span>
            </summary>
            <div class="more-body">
              <div class="row-2">
                <div class="field">
                  <label for="f-pattern">
                    Padrão <span class="opt">(opcional)</span>
                  </label>
                  <select id="f-pattern" name="pattern">
                    <option value="">Ainda não sei</option>
                    {patterns.map((p) => (
                      <option value={p.id}>
                        {p.code} {p.name}
                      </option>
                    ))}
                  </select>
                </div>
                <div class="field">
                  <label for="f-format">
                    Formato <span class="opt">(opcional)</span>
                  </label>
                  <select id="f-format" name="format">
                    <option value="">Ainda não sei</option>
                    {formats.map((f) => (
                      <option value={f.id}>{f.label}</option>
                    ))}
                  </select>
                </div>
              </div>
              <div class="field">
                <label for="f-area">
                  Área do projeto <span class="opt">(opcional)</span>
                </label>
                <select id="f-area" name="area">
                  <option value="">Selecione</option>
                  <option>Até 100 m²</option>
                  <option>Até 200 m²</option>
                  <option>Até 300 m²</option>
                  <option>Acima de 300 m²</option>
                </select>
              </div>
              <div class="field">
                <label for="f-message">
                  Mensagem <span class="opt">(opcional)</span>
                </label>
                <textarea id="f-message" name="message" rows="3"></textarea>
              </div>
            </div>
          </details>
          <div class="field">
            <label class="consent">
              <input type="checkbox" name="consent" required aria-describedby="e-consent" />
              <span>
                Concordo que a Belgotex use meus dados para responder a esta solicitação, conforme a{' '}
                <a href={config.privacyUrl} target="_blank" rel="noopener">
                  Política de privacidade<span class="sr-only"> (abre em nova aba)</span>
                </a>
                .
              </span>
            </label>
            <p class="err" id="e-consent" data-error-for="consent"></p>
          </div>
          <div class="submit-row">
            <button type="button" class="btn btn--secondary" data-back>
              Voltar
            </button>
            <button type="submit" class="btn btn--primary grow" data-submit>
              Solicitar cotação
            </button>
          </div>
          <div class="form-error" role="alert" data-form-error hidden>
            <p>
              <strong>Não conseguimos enviar agora.</strong> Seus dados continuam aqui. Tente de novo em
              instantes ou fale direto com um consultor.
            </p>
            <WaLink location="form_error" class="btn btn--secondary btn--sm" />
          </div>
        </fieldset>

        <div class="success" data-success hidden tabindex="-1">
          <svg class="check" viewBox="0 0 52 52" aria-hidden="true">
            <circle cx="26" cy="26" r="24" fill="none" stroke="currentColor" stroke-width="2"></circle>
            <path d="M15 27l7 7 15-16" fill="none" stroke="currentColor" stroke-width="2.5"></path>
          </svg>
          <h3>Pedido recebido</h3>
          <p>
            Obrigado! Um consultor Belgotex vai entrar em contato em breve. Se quiser, adiante a conversa pelo
            WhatsApp.
          </p>
          <WaLink location="form_success" class="btn btn--primary">
            Continuar no WhatsApp
          </WaLink>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  /* Seção escura com foto ao fundo: o formulário é o ponto mais claro da página */
  .lead-sec {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #17191c;
    color: #fff;
  }
  .lead-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.32;
    filter: saturate(0.8);
  }
  .lead-sec::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      rgba(23, 25, 28, 0.94) 0%,
      rgba(23, 25, 28, 0.78) 45%,
      rgba(23, 25, 28, 0.55) 100%
    );
  }
  .grid-12 {
    row-gap: 2.5rem;
    align-items: center;
  }
  .aside-eyebrow {
    color: rgba(255, 255, 255, 0.75);
  }
  .aside-lead {
    color: rgba(255, 255, 255, 0.82);
  }
  .aside-wa {
    color: rgba(255, 255, 255, 0.8);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.5rem;
  }
  .aside-wa :global(.aside-wa-link) {
    color: #fff;
    font-weight: 600;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .aside-wa :global(.aside-wa-link svg) {
    width: 18px;
    height: 18px;
  }
  .lead-sec :focus-visible {
    outline-color: #fff;
  }
  .form-card :focus-visible {
    outline-color: var(--ink);
  }
  .form-aside {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .form-card {
    color: var(--ink);
  }
  .form-card {
    grid-column: 1 / -1;
  }
  @media (min-width: 900px) {
    .form-aside {
      grid-column: 1 / span 5;
      position: sticky;
      top: 100px;
    }
    .form-card {
      grid-column: 7 / -1;
    }
  }
  .perks {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .perks li {
    padding-left: 1.75rem;
    position: relative;
  }
  .perk-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .perk-link:hover {
    text-decoration-thickness: 2px;
  }
  .perks li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.35em;
    width: 0.4rem;
    height: 0.75rem;
    border: solid #fff;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  form {
    background: var(--white);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    border-radius: 4px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 30px 80px -20px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.08);
  }
  /* Entrada do cartão quando a seção aparece */
  @media (prefers-reduced-motion: no-preference) {
    .form-card[data-wait] {
      opacity: 0;
      transform: translateY(28px);
    }
    .form-card {
      transition:
        opacity 0.7s ease,
        transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
  }

  /* Progresso: duas réguas; a segunda "encaixa" (clic) ao chegar na etapa 2 */
  .progress {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    margin-bottom: 0.5rem;
  }
  .progress[hidden] {
    display: none;
  }
  .pstep {
    display: grid;
    gap: 0.4rem;
  }
  .plank-slot {
    display: block;
    height: 10px;
    background: var(--stone);
    overflow: hidden;
  }
  .plank {
    display: block;
    height: 100%;
    background:
      var(--plank) center / cover,
      #b59a76;
    transform: translateX(-102%);
  }
  .plank.on {
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .plank[data-progress-2].on {
      animation: plank-clic 0.65s cubic-bezier(0.2, 0.9, 0.25, 1.15) both;
    }
    @keyframes plank-clic {
      0% {
        transform: translate(40%, -6px) rotate(-2deg);
        opacity: 0;
      }
      70% {
        transform: none;
        opacity: 1;
      }
      85% {
        transform: translateX(-2px);
      }
      100% {
        transform: none;
      }
    }
  }
  .pname {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .step-label {
    color: var(--ink-2);
    margin-bottom: 1.25rem;
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .step {
    display: grid;
    gap: 1.125rem;
  }
  .step[hidden] {
    display: none;
  }
  .field {
    display: grid;
    gap: 0.375rem;
  }
  .field > label {
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0;
  }
  .opt {
    font-weight: 400;
    color: var(--ink-2);
  }
  input[type='text'],
  input[type='tel'],
  input[type='email'],
  select,
  textarea {
    width: 100%;
    min-height: 52px;
    padding: 0.75rem 0.875rem;
    border: 1px solid #8a8d91;
    border-radius: var(--radius);
    background: var(--white);
    font-size: 1rem;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  input[type='text']:focus,
  input[type='tel']:focus,
  input[type='email']:focus,
  select:focus,
  textarea:focus {
    border-color: var(--ink);
    box-shadow: 0 0 0 3px rgba(35, 31, 32, 0.12);
  }
  .field:focus-within > label {
    color: var(--ink);
  }
  textarea {
    min-height: 96px;
    resize: vertical;
  }
  select {
    appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--ink) 50%),
      linear-gradient(135deg, var(--ink) 50%, transparent 50%);
    background-position:
      calc(100% - 18px) 50%,
      calc(100% - 13px) 50%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
    padding-right: 2.25rem;
  }
  [aria-invalid='true'] {
    border: 2px solid var(--error) !important;
  }
  .err {
    color: var(--error);
    font-size: var(--fs-sm);
    font-weight: 600;
    min-height: 0;
  }
  .err:empty {
    display: none;
  }
  .row-2 {
    display: grid;
    gap: 1.125rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 520px) {
    .row-2 {
      grid-template-columns: 1fr 1fr;
    }
    .row-2:has(#f-uf) {
      grid-template-columns: 1fr 120px;
    }
  }
  .consent {
    display: flex;
    gap: 0.625rem;
    cursor: pointer;
    min-height: 44px;
  }
  .consent {
    align-items: flex-start;
    font-size: var(--fs-sm);
    line-height: 1.5;
  }
  input[type='checkbox'] {
    width: 22px;
    height: 22px;
    accent-color: var(--ink);
    flex: none;
    margin: 0;
  }
  .consent input {
    margin-top: 1px;
  }
  .full {
    width: 100%;
  }
  .submit-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .grow {
    flex: 1;
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form-error[hidden] {
    display: none;
  }
  .form-error {
    border-left: 3px solid var(--error);
    padding: 0.75rem 1rem;
    background: #fbf1ef;
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  .more {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .more summary {
    min-height: 52px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.4rem;
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: 2rem;
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  .more summary::after {
    content: '+';
    position: absolute;
    right: 0.25rem;
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1;
  }
  .more[open] summary::after {
    content: '−';
  }
  .more-hint {
    flex-basis: 100%;
    font-weight: 400;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .more-hint:empty {
    display: none;
  }
  .more-body {
    display: grid;
    gap: 1.125rem;
    padding-bottom: 1.25rem;
  }
  .success {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .check {
    width: 56px;
    height: 56px;
    color: var(--ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .check circle {
      stroke-dasharray: 152;
      stroke-dashoffset: 152;
      animation: draw 0.6s ease-out forwards;
    }
    .check path {
      stroke-dasharray: 40;
      stroke-dashoffset: 40;
      animation: draw 0.35s 0.5s ease-out forwards;
    }
    @keyframes draw {
      to {
        stroke-dashoffset: 0;
      }
    }
  }
  .success[hidden] {
    display: none;
  }
  .success h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2rem;
  }
  [data-submit][aria-busy='true'] {
    opacity: 0.7;
    cursor: progress;
  }
</style>

<script>
  import { initForm } from '../scripts/form';
  initForm();

  // O cartão sobe quando a seção entra na tela
  const card = document.querySelector<HTMLElement>('[data-form-card]');
  if (card) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e!.isIntersecting) {
          card.dataset.wait = '';
          return;
        }
        delete card.dataset.wait;
        io.disconnect();
      },
      { threshold: 0.15 },
    );
    io.observe(card);
  }
</script>
