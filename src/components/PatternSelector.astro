---
import QuoteLink from './QuoteLink.astro';
import { Picture, getImage } from 'astro:assets';
import WaLink from './WaLink.astro';
import Icon from './Icon.astro';
import FormatScale from './FormatScale.astro';
import { config } from '../config';
import { formats, patterns, fmtSize } from '../lib/data';
import { patternImages } from '../lib/images';

const initialFormat = 'padrao';
const initialPattern = '001';
const thumbs = await Promise.all(
  patterns.map(async (p) => ({
    ...p,
    thumb: await getImage({
      src: patternImages[p.slug]!,
      width: 520,
      height: 81,
      fit: 'cover',
      format: 'webp',
      quality: 70,
    }),
  })),
);
const xl = formats.find((f) => f.id === 'xl')!;
// Texturas com a legenda da cor, geradas por scripts/make-downloads.py em public/downloads
const download = (slug: string) =>
  `/downloads/timberland-spc-${slug.replace(/^hb-/, '')}${slug.startsWith('hb-') ? '-hb' : ''}.jpg`;
const formatLabel = Object.fromEntries(formats.map((f) => [f.id, f.short]));
---

<section id="padroes" class="section" data-section-id="patterns" aria-labelledby="padroes-title">
  <div class="container">
    <div class="section-head">
      <h2 id="padroes-title">7 padrões de carvalho, 3 formatos de régua</h2>
      <p class="lead">
        Inspirado nas texturas e cores da natureza. Escolha o formato e a cor para ver os detalhes.
      </p>
    </div>

    <div
      class="selector"
      data-selector
      data-initial-format={initialFormat}
      data-initial-pattern={initialPattern}
    >
      <fieldset class="formats">
        <legend>Formato</legend>
        <div class="seg">
          {formats.map((f) => (
            <label>
              <input
                type="radio"
                name="format"
                value={f.id}
                checked={f.id === initialFormat}
                data-label={f.label}
                data-size={fmtSize(f)}
                data-thickness={f.thickness}
              />
              <span>
                <strong>{f.short}</strong>
                <small>{fmtSize(f)}</small>
              </span>
            </label>
          ))}
        </div>
      </fieldset>
      <p class="xl-note small" data-xl-note hidden>
        O grande formato é mais robusto: {xl.thickness.replace('IXPE', 'de base acústica IXPE')} de espessura,
        capa de uso de {xl.wear} e classificação de uso {xl.useClass}. Disponível em 001 Canyon Oak e 002
        Classic Oak.
      </p>
      <FormatScale initial={initialFormat} />

      <div class="grid-12 sel-body">
        <fieldset class="patterns">
          <legend>Cor</legend>
          <ul>
            {thumbs.map((p) => (
              <li data-formats={p.formats.join(' ')} hidden={!p.formats.includes(initialFormat)}>
                <label>
                  <input
                    type="radio"
                    name="pattern"
                    value={p.id}
                    checked={p.id === initialPattern}
                    disabled={!p.formats.includes(initialFormat)}
                    data-name={`${p.code} ${p.name}`}
                    data-skp={p.skp}
                    data-download={download(p.slug)}
                    data-note={p.note}
                    data-formats={p.formats.join(' ')}
                  />
                  <img src={p.thumb.src} width="520" height="81" alt="" loading="lazy" decoding="async" />
                  <span class="p-name">
                    <span class="p-code">{p.code}</span> {p.name}
                  </span>
                </label>
              </li>
            ))}
          </ul>
        </fieldset>

        <div class="preview" aria-live="polite">
          <div class="preview-media">
            {patterns.map((p) => (
              <a
                class="pv-img"
                data-preview={p.id}
                hidden={p.id !== initialPattern}
                href={download(p.slug)}
                download
                data-doc="texture"
                data-cta="document"
                data-cta-id={`texture_${p.id}`}
                data-loc="pattern"
                title="Clique para baixar a textura com a legenda"
              >
                <Picture
                  src={patternImages[p.slug]!}
                  formats={['avif', 'webp']}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 1240px) 660px, (min-width: 900px) 55vw, 100vw"
                  alt={`Textura do padrão ${p.code} ${p.name}`}
                  loading="lazy"
                  quality={72}
                />
                <span class="pv-dl" aria-hidden="true">
                  <Icon name="download" /> Baixar textura
                </span>
                <span class="sr-only">Baixar a textura {p.code} {p.name} com legenda (JPG)</span>
              </a>
            ))}
          </div>
          <div class="preview-info">
            <h3 class="pv-name" data-pv-name>
              001 Canyon Oak
            </h3>
            <dl class="kv">
              <div>
                <dt>Formato</dt>
                <dd data-pv-format>Regular</dd>
              </div>
              <div>
                <dt>Medida</dt>
                <dd data-pv-size>123,5 × 19,2 cm</dd>
              </div>
              <div>
                <dt>Espessura</dt>
                <dd data-pv-thick>{formats.find((f) => f.id === initialFormat)!.thickness}</dd>
              </div>
              <div>
                <dt>Também em</dt>
                <dd data-pv-also>Grande formato (XL)</dd>
              </div>
            </dl>
            <p class="small muted" data-pv-note hidden></p>

            <div class="actions">
              <QuoteLink class="btn btn--primary" loc="pattern">Solicitar cotação</QuoteLink>
              <!-- ROOMVO: gatilho do plug-in no seletor (data-roomvo-pattern acompanha o padrão escolhido) -->
              <a
                class="btn btn--secondary"
                href={config.simulatorUrl}
                target="_blank"
                rel="noopener"
                data-roomvo-trigger
                data-roomvo-product="timberland-spc"
                data-roomvo-pattern={initialPattern}
                data-cta="simulator"
                data-cta-id="simulator_pattern"
                data-loc="pattern"
              >
                Ver no meu ambiente
                <span class="sr-only"> (abre o simulador em nova aba)</span>
              </a>
            </div>
            <div class="sub-actions">
              <WaLink location="pattern" class="link-arrow" />
              <a
                class="link-arrow"
                href="#amostra"
                data-sample-open
                data-sample-from-selector
                data-cta="sample"
                data-cta-id="sample_pattern"
                data-loc="pattern"
              >
                Pedir amostra desta cor <Icon name="arrow" />
              </a>
              <a
                class="link-arrow"
                href={download(patterns[0]!.slug)}
                data-pv-download
                download
                data-doc="texture"
                data-cta="document"
                data-cta-id="texture_download"
                data-loc="pattern"
              >
                Baixar textura com legenda (JPG) <Icon name="download" />
              </a>
              <a
                class="link-arrow"
                href={patterns[0]!.skp}
                data-pv-skp
                data-doc="skp"
                data-cta="document"
                data-cta-id="document_skp"
                data-loc="pattern"
                download
              >
                Baixar SketchUp (.skp) <Icon name="download" />
              </a>
            </div>
          </div>
        </div>
      </div>
      <script type="application/json" data-format-labels set:html={JSON.stringify(formatLabel)} />
    </div>
  </div>
</section>

<style>
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  legend {
    font-weight: 600;
    margin-bottom: 0.75rem;
    padding: 0;
  }
  .seg {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    max-width: 560px;
  }
  .seg label {
    position: relative;
    display: block;
  }
  .seg label + label {
    border-left: 1.5px solid var(--ink);
  }
  .seg input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .seg span {
    display: grid;
    gap: 0.125rem;
    padding: 0.75rem clamp(0.5rem, 2vw, 0.875rem);
    min-height: 64px;
    align-content: center;
    cursor: pointer;
  }
  .seg small {
    font-size: 0.8125rem;
    color: var(--ink-2);
    line-height: 1.3;
  }
  @media (max-width: 399px) {
    .seg small {
      font-size: 0.75rem;
    }
  }
  .seg input:checked + span {
    background: var(--ink);
    color: var(--paper);
  }
  .seg input:checked + span small {
    color: var(--stone);
  }
  .seg input:focus-visible + span {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
    position: relative;
    z-index: 1;
  }
  .xl-note {
    margin-top: 0.75rem;
  }

  .sel-body {
    margin-top: 2rem;
    row-gap: 2rem;
    align-items: start;
  }
  .patterns {
    grid-column: 1 / -1;
  }
  .preview {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .patterns {
      grid-column: 1 / span 4;
    }
    .preview {
      grid-column: 6 / -1;
    }
  }
  .patterns ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) and (max-width: 899px) {
    .patterns ul {
      grid-template-columns: 1fr 1fr;
    }
  }
  .patterns label {
    position: relative;
    display: grid;
    gap: 0.5rem;
    cursor: pointer;
    padding: 0.5rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
  }
  .patterns input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .patterns img {
    width: 100%;
    aspect-ratio: 6.43 / 1;
    object-fit: cover;
  }
  .p-name {
    font-weight: 500;
  }
  .p-code {
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    margin-right: 0.25rem;
  }
  .patterns label:hover {
    border-color: var(--line);
  }
  .patterns label:has(input:checked) {
    border-color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink);
  }
  .patterns label:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .preview-media {
    background: var(--sand);
  }
  .pv-img {
    position: relative;
    display: block;
    overflow: hidden;
    cursor: pointer;
  }
  .pv-img[hidden] {
    display: none;
  }
  .pv-img :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  /* Selo "Baixar textura": sempre visível no toque, aparece no hover com mouse */
  .pv-dl {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: rgba(35, 31, 32, 0.82);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    backdrop-filter: blur(6px);
    transition:
      opacity 0.25s,
      transform 0.25s;
  }
  .pv-dl :global(svg) {
    width: 16px;
    height: 16px;
  }
  @media (hover: hover) and (pointer: fine) {
    .pv-dl {
      opacity: 0;
      transform: translateY(6px);
    }
    .pv-img:hover .pv-dl,
    .pv-img:focus-visible .pv-dl {
      opacity: 1;
      transform: none;
    }
    .pv-img:hover :global(img) {
      transform: scale(1.03);
    }
  }
  .preview-info {
    display: grid;
    gap: 1.25rem;
  }
  .pv-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    line-height: 1.1;
  }
  .kv {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .kv div {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }
  .kv dt {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .kv dd {
    margin: 0;
    font-weight: 600;
  }
  .sub-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  .sub-actions :global(svg) {
    width: 18px;
    height: 18px;
  }
</style>

<script>
  import { initSelector } from '../scripts/selector';
  initSelector();
</script>
