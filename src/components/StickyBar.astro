---
// O WhatsApp fica no botão flutuante (WhatsAppFab), alinhado à direita desta barra
---

<nav class="sticky-bar" data-sticky aria-label="Ações rápidas">
  <a
    class="btn btn--primary"
    href="#cotacao"
    data-cta="quote"
    data-cta-id="quote_sticky_bar"
    data-loc="sticky_bar"
  >
    Solicitar cotação
  </a>
</nav>
<style>
  .sticky-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 45;
    display: flex;
    gap: 0.5rem;
    padding: 0.625rem calc(var(--gutter) + 56px + 0.75rem) calc(0.625rem + env(safe-area-inset-bottom))
      var(--gutter);
    background: var(--paper);
    border-top: 1px solid var(--line);
    transform: translateY(110%);
    transition: transform 0.25s ease;
    visibility: hidden;
  }
  .sticky-bar.show {
    transform: none;
    visibility: visible;
  }
  .sticky-bar :global(.btn) {
    flex: 1;
    min-height: 48px;
    padding: 0 0.75rem;
    font-size: 0.9375rem;
  }
  @media (min-width: 768px) {
    .sticky-bar {
      display: none;
    }
  }
</style>
<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky]');
  const hero = document.getElementById('inicio');
  const form = document.getElementById('cotacao');
  if (bar && hero && form) {
    let pastHero = false;
    let inForm = false;
    const update = () => bar.classList.toggle('show', pastHero && !inForm);
    new IntersectionObserver(
      ([e]) => {
        pastHero = !e!.isIntersecting;
        update();
      },
      { rootMargin: '-120px 0px 0px 0px' },
    ).observe(hero);
    new IntersectionObserver(
      ([e]) => {
        inForm = e!.isIntersecting;
        update();
      },
      { threshold: 0.05 },
    ).observe(form);
  }
</script>
