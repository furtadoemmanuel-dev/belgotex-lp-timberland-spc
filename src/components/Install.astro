---
import { getImage } from 'astro:assets';
import WaLink from './WaLink.astro';
import Icon from './Icon.astro';
import { installSteps, documents } from '../lib/data';
import decorSrc from '../assets/layers/decor-canyon-oak.jpg';

const guide = documents.find((d) => d.id === 'instalacao')!;
const decor = await getImage({ src: decorSrc, width: 694, format: 'webp', quality: 78 });

/*
 * Corte de duas réguas com o perfil de encaixe angle-angle (ilustrativo), em coordenadas do perfil:
 * espessura 0–100, junta em x = 0. A régua da esquerda tem o sulco e o lábio inferior com a trava;
 * a da direita tem a lingueta e o rebaixo que trava no lábio. Ver src/scripts/clic.ts.
 * As duas réguas usam a MESMA linha de junta (cada uma de um lado), então o encaixe fecha sem folga.
 */
const JOINT = [
  [0, 30], // fim do microbisel, desce a face da junta
  [-24, 36], // lingueta entra no sulco
  [-24, 54],
  [0, 60],
  [0, 70], // apoio sobre o lábio inferior
  [40, 70],
  [44, 52], // ressalto de trava
  [58, 52],
  [64, 60],
  [70, 100], // saída inclinada até a base
]
  .map(([x, y]) => `L${x} ${y}`)
  .join('');
const L_PATH = `M-900 0H-4L0 4${JOINT}H-900Z`;
const R_PATH = `M900 0H4L0 4${JOINT}H900Z`;
// Face de cima em perspectiva (recua para o fundo) com a textura da madeira
const [iw, ih] = [694, 256];
const D = [26, -78]; // profundidade
const topL = `-900,0 0,0 ${D[0]!},${D[1]} ${-900 + D[0]!},${D[1]}`;
const topR = `0,0 900,0 ${900 + D[0]!},${D[1]} ${D[0]!},${D[1]}`;
const texL = `matrix(${900 / iw} 0 ${D[0]! / ih} ${D[1]! / ih} -900 0)`;
const texR = `matrix(${900 / iw} 0 ${D[0]! / ih} ${D[1]! / ih} 0 0)`;
---

<section id="instalacao" class="section" data-section-id="install" aria-labelledby="instalacao-title">
  <div class="container">
    <div class="section-head">
      <h2 id="instalacao-title">Instalação clic: limpa, rápida e sem cola</h2>
      <p class="lead">
        O sistema angle-angle deixa a instalação até 30% mais rápida que a de LVTs tradicionais, e mais
        econômica.
      </p>
    </div>

    <figure class="clic" data-clic>
      <svg
        viewBox="0 0 1600 760"
        preserveAspectRatio="xMidYMid slice"
        role="img"
        aria-labelledby="clic-title clic-desc"
      >
        <title id="clic-title">Sistema clic: encaixe angle-angle</title>
        <desc id="clic-desc">
          Corte de duas réguas. A régua da direita entra inclinada a 30 graus, encaixa a lingueta no sulco da
          régua da esquerda, encosta a superfície na dela e gira até deitar e travar, sem cola.
        </desc>
        <defs>
          <radialGradient id="clic-bg" cx="50%" cy="45%" r="75%">
            <stop offset="0" stop-color="#2a2c33"></stop>
            <stop offset="1" stop-color="#111216"></stop>
          </radialGradient>
          <linearGradient id="clic-core" x1="0" y1="0" x2="0" y2="100" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#2f2621"></stop>
            <stop offset="1" stop-color="#16110e"></stop>
          </linearGradient>
          <linearGradient id="clic-rim" x1="-300" y1="0" x2="300" y2="0" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#e2b277" stop-opacity="0"></stop>
            <stop offset="0.5" stop-color="#f1cf9c"></stop>
            <stop offset="1" stop-color="#e2b277" stop-opacity="0"></stop>
          </linearGradient>
          <linearGradient id="clic-shade" x1="0" y1="0" x2="0" y2="-78" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#000" stop-opacity="0.1"></stop>
            <stop offset="1" stop-color="#000" stop-opacity="0.72"></stop>
          </linearGradient>
          <radialGradient id="clic-flash">
            <stop offset="0" stop-color="#ffe2b0" stop-opacity="0.95"></stop>
            <stop offset="1" stop-color="#ffe2b0" stop-opacity="0"></stop>
          </radialGradient>
          <clipPath id="clic-cl">
            <path d={L_PATH}></path>
          </clipPath>
          <clipPath id="clic-cr">
            <path d={R_PATH}></path>
          </clipPath>
          <filter id="clic-glow" x="-20%" y="-50%" width="140%" height="200%">
            <feGaussianBlur stdDeviation="3"></feGaussianBlur>
          </filter>
        </defs>

        <rect width="1600" height="760" fill="url(#clic-bg)"></rect>
        <text x="800" y="170" text-anchor="middle" class="clic-label">
          Sistema clic
        </text>

        <g transform="translate(800 470) scale(1.6)">
          <!-- Régua da esquerda (fixa) -->
          <g>
            <polygon points={topL} fill="#6b5039"></polygon>
            <image href={decor.src} width={iw} height={ih} preserveAspectRatio="none" transform={texL} />
            <polygon points={topL} fill="url(#clic-shade)"></polygon>
            <path d={L_PATH} fill="url(#clic-core)"></path>
            <rect x="-900" y="0" width="1000" height="5" fill="#8a6a49" clip-path="url(#clic-cl)"></rect>
            <path
              d={L_PATH}
              fill="none"
              stroke="url(#clic-rim)"
              stroke-width="2.2"
              filter="url(#clic-glow)"
              opacity="0.7"
            ></path>
            <path d={L_PATH} fill="none" stroke="url(#clic-rim)" stroke-width="0.7"></path>
          </g>

          <!-- Régua da direita (entra inclinada e encaixa) -->
          <g data-clic-r>
            <polygon points={topR} fill="#6b5039"></polygon>
            <image href={decor.src} width={iw} height={ih} preserveAspectRatio="none" transform={texR} />
            <polygon points={topR} fill="url(#clic-shade)"></polygon>
            <path d={R_PATH} fill="url(#clic-core)"></path>
            <rect x="-30" y="0" width="1000" height="5" fill="#8a6a49" clip-path="url(#clic-cr)"></rect>
            <path
              d={R_PATH}
              fill="none"
              stroke="url(#clic-rim)"
              stroke-width="2.2"
              filter="url(#clic-glow)"
              opacity="0.7"
            ></path>
            <path d={R_PATH} fill="none" stroke="url(#clic-rim)" stroke-width="0.7"></path>
          </g>

          <!-- Brilho do "clic" no ponto de encaixe -->
          <circle data-clic-flash cx="20" cy="45" r="46" fill="url(#clic-flash)" opacity="0"></circle>
        </g>
      </svg>
      <figcaption class="clic-cap">
        <span>Encaixe angle-angle · ilustração</span>
        <button type="button" class="clic-pause" data-clic-pause aria-pressed="false">
          <span data-label-pause>Pausar animação</span>
          <span data-label-play hidden>
            Retomar animação
          </span>
        </button>
      </figcaption>
    </figure>

    <ol class="steps">
      {installSteps.map((s, i) => (
        <li class="step" style={`--i:${i}`}>
          <span class="step-num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="step-title">{s.title}</h3>
          <p class="step-text">{s.text}</p>
        </li>
      ))}
    </ol>

    <div class="care">
      <div>
        <h3>Conservação simples</h3>
        <p class="muted">
          No dia a dia, vassoura macia ou mop de microfibra. Para lavar, detergente neutro diluído em água.
        </p>
      </div>
      <div class="actions">
        <a
          class="btn btn--secondary btn--sm"
          href={guide.url}
          target="_blank"
          rel="noopener"
          data-doc="instalacao"
          data-cta="document"
          data-cta-id="document_instalacao"
          data-loc="install"
        >
          <Icon name="download" />
          Guia de instalação (PDF)<span class="sr-only"> (abre em nova aba)</span>
        </a>
        <WaLink location="install" class="btn btn--secondary btn--sm" />
      </div>
    </div>
  </div>
</section>

<style>
  /* Painel escuro com o corte animado */
  .clic {
    position: relative;
    margin: 0 0 clamp(2rem, 1.5rem + 2vw, 3rem);
    border-radius: 4px;
    overflow: hidden;
    background: #111216;
  }
  .clic svg {
    display: block;
    width: 100%;
    aspect-ratio: 1600 / 760;
    min-height: 300px;
  }
  .clic-label {
    fill: #fff;
    font: 300 46px var(--font-body);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .clic-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.25rem clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.72);
  }
  .clic-pause {
    min-height: 44px;
    padding: 0 0.25rem;
    background: none;
    border: 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.75rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .clic-pause:focus-visible {
    outline-color: #fff;
  }
  .clic[data-static] .clic-pause {
    display: none;
  }

  /* Cards dos passos: linha fina, muito respiro, número discreto */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    grid-template-columns: minmax(0, 1fr);
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem) clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
    background: var(--white);
    transition: background-color 0.35s ease;
  }
  .step::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    height: 2px;
    width: 100%;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .step:hover {
      background: var(--paper);
    }
    .step:hover::before {
      transform: scaleX(1);
    }
  }
  .step-num {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--ink-2);
  }
  .step-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.005em;
  }
  .step-text {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  /* Entrada: a linha de cima de cada card passa da esquerda para a direita, em sequência */
  @media (prefers-reduced-motion: no-preference) {
    .steps.in .step::before {
      animation: step-line 1.1s cubic-bezier(0.65, 0, 0.35, 1) both;
      animation-delay: calc(var(--i) * 0.12s);
    }
    @keyframes step-line {
      0% {
        transform: scaleX(0);
        transform-origin: left;
      }
      50% {
        transform: scaleX(1);
        transform-origin: left;
      }
      50.1% {
        transform: scaleX(1);
        transform-origin: right;
      }
      100% {
        transform: scaleX(0);
        transform-origin: right;
      }
    }
  }

  .care {
    margin-top: 1.5rem;
    padding: 1.75rem;
    background: var(--sand);
    display: grid;
    gap: 1.25rem;
    align-items: center;
    border-radius: 4px;
  }
  @media (min-width: 900px) {
    .care {
      grid-template-columns: 1fr auto;
    }
  }
  .care h3 {
    margin-bottom: 0.375rem;
  }
</style>

<script>
  import { initClic } from '../scripts/clic';
  initClic();

  const steps = document.querySelector<HTMLElement>('#instalacao .steps');
  if (steps) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e!.isIntersecting) return;
        steps.classList.add('in');
        io.disconnect();
      },
      { threshold: 0.3 },
    );
    io.observe(steps);
  }
</script>
