---
/** Divisor em réguas com juntas desencontradas (proporção 6,43:1), como num assoalho. */
interface Props {
  tone?: 'paper' | 'sand';
}
const { tone = 'paper' } = Astro.props;
---

<div class:list={['planks', `planks--${tone}`]} aria-hidden="true">
  <span></span>
  <span></span>
</div>

<style>
  .planks {
    --h: 12px;
    --len: calc(var(--h) * 6.43);
    display: grid;
    gap: 2px;
    padding-block: 0;
  }
  .planks span {
    display: block;
    height: var(--h);
    background: repeating-linear-gradient(
      90deg,
      var(--stone) 0 calc(var(--len) - 2px),
      transparent calc(var(--len) - 2px) var(--len)
    );
  }
  .planks span:last-child {
    background-position: calc(var(--len) / 3) 0;
  }
  .planks--sand {
    background: var(--sand);
  }
  @media (min-width: 900px) {
    .planks {
      --h: 16px;
    }
  }
</style>
