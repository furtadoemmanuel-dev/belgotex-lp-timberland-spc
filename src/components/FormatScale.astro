---
/**
 * Os 3 formatos de régua lado a lado, em escala real entre si (1 cm = 1 cm), sobre uma régua de 0 a 190 cm.
 * Texturas originais do fornecedor: Canyon Oak (Padrão e XL) e Harmony Oak (HB, único padrão que existe em HB).
 * Gerado por scripts/prepare-assets.py → src/assets/formats/.
 * Referência de altura do catálogo (p. 7): uma pessoa de 1,73 m, marcada na mesma escala.
 */
import { getImage } from 'astro:assets';
import { formats, fmtSize } from '../lib/data';
import padrao from '../assets/formats/padrao.jpg';
import hb from '../assets/formats/hb.jpg';
import xl from '../assets/formats/xl.jpg';

interface Props {
  initial: string;
}
const { initial } = Astro.props;

const RULER_CM = 190;
const PERSON_CM = 173;
const tex = { padrao, hb, xl } as const;
const example = { padrao: 'Canyon Oak', hb: 'Harmony Oak', xl: 'Canyon Oak' } as const;
const rows = await Promise.all(
  formats.map(async (f, i) => ({
    ...f,
    i,
    example: example[f.id],
    img: await getImage({ src: tex[f.id], width: 1200, format: 'webp', quality: 72 }),
  })),
);
const ticks = Array.from({ length: RULER_CM / 10 + 1 }, (_, i) => i * 10);
---

<figure class="fs" data-fs style={`--ruler:${RULER_CM};--person:${PERSON_CM}`}>
  <figcaption class="fs-cap">
    <span class="fs-title">Os 3 formatos em escala</span>
    <span class="small fs-sub">
      Proporções reais entre as réguas. Exemplos com a textura original: Canyon Oak e Harmony Oak (HB). A
      linha tracejada marca 1,73 m, a altura de uma pessoa: o XL é maior.
    </span>
  </figcaption>

  <div class="fs-stage">
    <div class="fs-person" aria-hidden="true">
      <span class="fs-person-tag">
        <svg viewBox="0 0 24 64" width="12" height="32" focusable="false">
          <circle cx="12" cy="6" r="5"></circle>
          <path d="M7 14h10a3 3 0 0 1 3 3v18h-3v27h-4.5V40h-1v22H7V35H4V17a3 3 0 0 1 3-3z"></path>
        </svg>
        1,73 m
      </span>
    </div>
    {rows.map((r) => (
      <div class:list={['fs-row', { on: r.id === initial }]} data-scale={r.id} style={`--i:${r.i}`}>
        <p class="fs-label">
          <strong>{r.short}</strong>
          <span>{fmtSize(r)}</span>
          <span class="fs-ex" aria-hidden="true">
            · {r.example}
          </span>
        </p>
        <span class="fs-plank" style={`--w:${r.widthCm};--h:${r.heightCm}`}>
          <img
            src={r.img.src}
            alt=""
            width="1200"
            height={Math.round((1200 * r.heightCm) / r.widthCm)}
            loading="lazy"
            decoding="async"
          />
        </span>
      </div>
    ))}

    <div class="fs-ruler" aria-hidden="true">
      {ticks.map((t) => (
        <span class:list={['fs-tick', { major: t % 50 === 0 }]} style={`--t:${t}`}>
          {t % 50 === 0 && <span class="fs-tick-label">{t === 0 ? '0' : `${t} cm`}</span>}
        </span>
      ))}
    </div>
  </div>
</figure>

<style>
  .fs {
    margin: 1.75rem 0 0;
    padding: clamp(1rem, 0.75rem + 1.5vw, 2rem);
    background: var(--sand);
    border-radius: var(--radius);
  }
  .fs-cap {
    display: grid;
    gap: 0.2rem;
    margin-bottom: 1.25rem;
  }
  .fs-title {
    font-weight: 600;
  }
  .fs-sub {
    color: var(--ink-2);
  }
  .fs-stage {
    position: relative;
    display: grid;
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
    padding-top: 2.75rem;
  }
  /* Altura de uma pessoa (1,73 m) na mesma escala das réguas */
  .fs-person {
    position: absolute;
    top: 0;
    bottom: 2.5rem;
    left: calc(var(--person) / var(--ruler) * 100%);
    border-left: 1px dashed var(--ink-2);
    pointer-events: none;
    z-index: 1;
    transform-origin: bottom;
  }
  .fs-person-tag {
    position: absolute;
    top: 0;
    right: 0.4rem;
    display: flex;
    align-items: flex-end;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-2);
    white-space: nowrap;
    line-height: 1;
  }
  .fs-person-tag svg {
    flex: none;
    width: 12px;
    height: 32px;
    fill: currentColor;
  }

  .fs-row {
    display: grid;
    gap: 0.35rem;
    cursor: pointer;
    opacity: 0.72;
    filter: saturate(0.6);
    transition:
      opacity 0.45s ease,
      filter 0.45s ease;
  }
  .fs-row.on {
    opacity: 1;
    filter: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .fs-row:hover {
      opacity: 1;
      filter: none;
    }
  }
  .fs-label {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.4rem;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .fs-label strong {
    color: var(--ink);
  }
  .fs-row.on .fs-label {
    color: var(--ink);
  }

  /* Largura proporcional à régua de 190 cm; altura pela proporção real da régua */
  .fs-plank {
    position: relative;
    display: block;
    width: calc(var(--w) / var(--ruler) * 100%);
    aspect-ratio: var(--w) / var(--h);
    overflow: hidden;
    border-radius: 1px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.5) inset,
      0 10px 18px -12px rgba(35, 31, 32, 0.55);
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.45s ease;
  }
  .fs-plank img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fs-row.on .fs-plank {
    transform: translateY(-2px);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.5) inset,
      0 18px 26px -14px rgba(35, 31, 32, 0.6);
  }
  /* Reflexo de luz que atravessa a régua escolhida */
  .fs-plank::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgba(255, 255, 255, 0.38) 50%, transparent 65%);
    transform: translateX(-120%);
    pointer-events: none;
  }

  .fs-ruler {
    position: relative;
    height: 2.25rem;
    border-top: 1px solid var(--ink);
    margin-top: 0.25rem;
  }
  .fs-tick {
    position: absolute;
    top: 0;
    left: calc(var(--t) / var(--ruler) * 100%);
    width: 1px;
    height: 6px;
    background: var(--ink);
  }
  .fs-tick.major {
    height: 11px;
  }
  .fs-tick-label {
    position: absolute;
    top: 14px;
    left: 0;
    transform: translateX(-50%);
    font-size: 0.75rem;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .fs-tick:first-child .fs-tick-label {
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .fs-row.on .fs-plank::after {
      animation: fs-sheen 1.1s ease 0.15s;
    }
    @keyframes fs-sheen {
      to {
        transform: translateX(120%);
      }
    }
    /* Entrada: as réguas se desenrolam da esquerda, em sequência, e a régua de medida cresce junto */
    .fs[data-wait] .fs-plank {
      clip-path: inset(0 100% 0 0);
    }
    .fs[data-wait] .fs-label,
    .fs[data-wait] .fs-tick {
      opacity: 0;
    }
    .fs[data-wait] .fs-ruler {
      border-top-color: transparent;
    }
    .fs[data-wait] .fs-person {
      transform: scaleY(0);
    }
    .fs[data-wait] .fs-person-tag {
      opacity: 0;
    }
    .fs.in .fs-person {
      animation: fs-grow 0.9s cubic-bezier(0.65, 0, 0.25, 1) 0.7s both;
    }
    .fs.in .fs-person-tag {
      animation: fs-fade 0.5s ease 1.4s both;
    }
    @keyframes fs-grow {
      from {
        transform: scaleY(0);
      }
    }
    .fs.in .fs-plank {
      animation: fs-reveal 1s cubic-bezier(0.65, 0, 0.25, 1) both;
      animation-delay: calc(0.15s + var(--i) * 0.14s);
    }
    .fs.in .fs-label {
      animation: fs-fade 0.5s ease both;
      animation-delay: calc(0.35s + var(--i) * 0.14s);
    }
    .fs.in .fs-tick {
      animation: fs-fade 0.4s ease both;
      animation-delay: calc(var(--t) / var(--ruler) * 0.8s);
    }
    @keyframes fs-reveal {
      from {
        clip-path: inset(0 100% 0 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }
    @keyframes fs-fade {
      from {
        opacity: 0;
      }
    }
  }
</style>

<script>
  // Clicar numa régua escolhe o formato (os botões de rádio continuam sendo o controle principal)
  document.querySelectorAll<HTMLElement>('[data-fs] [data-scale]').forEach((row) =>
    row.addEventListener('click', () => {
      document.querySelector<HTMLInputElement>(`input[name="format"][value="${row.dataset.scale}"]`)?.click();
    }),
  );
  const fs = document.querySelector<HTMLElement>('[data-fs]');
  if (fs) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e!.isIntersecting) {
          fs.dataset.wait = '';
          return;
        }
        delete fs.dataset.wait;
        fs.classList.add('in');
        io.disconnect();
      },
      { threshold: 0.35 },
    );
    io.observe(fs);
  }
</script>
