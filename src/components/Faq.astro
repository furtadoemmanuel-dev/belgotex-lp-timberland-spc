---
import { getImage } from 'astro:assets';
import WaLink from './WaLink.astro';
import { faq } from '../lib/data';
import { environmentImages } from '../lib/images';

// Fundo escuro com foto (o mesmo que o bloco de cotação usava na v01, aprovado pela Belgotex)
const bg = await getImage({
  src: environmentImages['pacific-oak-hall']!,
  width: 1600,
  format: 'webp',
  quality: 55,
});
---

<section id="perguntas" class="section faq-sec" data-section-id="faq" aria-labelledby="perguntas-title">
  <img class="faq-bg" src={bg.src} alt="" width="1600" height="1067" loading="lazy" decoding="async" />
  <div class="container grid-12">
    <div class="faq-head">
      <h2 id="perguntas-title">Perguntas frequentes</h2>
      <p class="muted">Não encontrou o que procurava?</p>
      <WaLink location="faq" class="link-arrow" />
    </div>
    <div class="faq-list">
      {faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <div class="answer">
            <p>{item.a}</p>
            {item.cta === 'consultant' && <WaLink location="faq_answer" class="link-arrow" />}
            {item.cta === 'sample' && (
              <a
                class="link-arrow"
                href="#amostra"
                data-sample-open
                data-cta="sample"
                data-cta-id="sample_faq"
                data-loc="faq"
              >
                Pedir amostra
              </a>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  /* Seção escura com foto ao fundo */
  .faq-sec {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #17191c;
    color: #fff;
  }
  .faq-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    opacity: 0.32;
    filter: saturate(0.8);
  }
  .faq-sec::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      rgba(23, 25, 28, 0.94) 0%,
      rgba(23, 25, 28, 0.8) 45%,
      rgba(23, 25, 28, 0.62) 100%
    );
  }
  .faq-sec :focus-visible {
    outline-color: #fff;
  }
  .faq-sec .muted {
    color: rgba(255, 255, 255, 0.78);
  }
  .grid-12 {
    row-gap: 2rem;
  }
  .faq-head {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .faq-list {
    grid-column: 1 / -1;
    border-top: 1px solid rgba(255, 255, 255, 0.85);
  }
  @media (min-width: 900px) {
    .faq-head {
      grid-column: 1 / span 4;
    }
    .faq-list {
      grid-column: 6 / -1;
    }
  }
  details {
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
  }
  summary {
    cursor: pointer;
    padding: 1.25rem 2.5rem 1.25rem 0;
    font-weight: 600;
    list-style: none;
    position: relative;
    min-height: 44px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 0.95rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1;
  }
  details[open] summary::after {
    content: '−';
  }
  .answer {
    padding: 0 0 1.5rem;
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    color: rgba(255, 255, 255, 0.82);
  }
  .answer :global(a),
  .faq-head :global(a) {
    color: #fff;
  }
  .faq-head :global(svg),
  .answer :global(svg) {
    width: 20px;
    height: 20px;
  }
</style>
