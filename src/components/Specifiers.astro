---
import WaLink from './WaLink.astro';
import Icon from './Icon.astro';
import { documents } from '../lib/data';
const shown = documents.filter((d) => ['ficha', '3dwarehouse', 'laudos', 'casoca'].includes(d.id));
---

<section
  id="especificadores"
  class="section section--sand specifiers"
  data-section-id="specifiers"
  aria-labelledby="especificadores-title"
>
  <div class="container grid-12">
    <div class="spec-copy">
      <h2 id="especificadores-title">Especifique Timberland no seu projeto</h2>
      <p class="lead">
        Ficha técnica, blocos de SketchUp e laudos prontos para baixar. Precisa ver o material de perto? Peça
        uma amostra.
      </p>
      <div class="actions">
        <a
          class="btn btn--primary"
          href="#amostra"
          data-sample-open
          data-cta="sample"
          data-cta-id="sample_specifiers"
          data-loc="specifiers"
        >
          Pedir amostra
        </a>
        <WaLink location="specifiers" class="btn btn--secondary" />
      </div>
    </div>
    <ul class="docs">
      {shown.map((d) => (
        <li>
          <a
            href={d.url}
            target="_blank"
            rel="noopener"
            data-doc={d.id}
            data-cta="document"
            data-cta-id={`document_${d.id}`}
            data-loc="specifiers"
          >
            <span class="doc-label">{d.label}</span>
            <span class="doc-meta small">
              {d.meta}
              <span class="sr-only"> (abre em nova aba)</span>
            </span>
            <Icon name={d.meta.startsWith('PDF') ? 'download' : 'external'} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .specifiers .grid-12 {
    row-gap: 2.5rem;
    align-items: center;
  }
  .spec-copy {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.25rem;
  }
  .docs {
    grid-column: 1 / -1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--ink);
  }
  @media (min-width: 900px) {
    .spec-copy {
      grid-column: 1 / span 5;
    }
    .docs {
      grid-column: 7 / -1;
    }
  }
  .docs a {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 1rem;
    padding: 1.125rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    min-height: 64px;
  }
  .docs a:hover .doc-label {
    text-decoration: underline;
  }
  .doc-label {
    font-weight: 600;
    font-size: 1.0625rem;
  }
  .doc-meta {
    color: var(--ink-2);
    grid-row: 2;
  }
  .docs :global(svg) {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    width: 24px;
    height: 24px;
  }
</style>
