---
import { Picture } from 'astro:assets';
import { closeupImages } from '../lib/images';
// Close do relevo com luz rasante (referência do Emmanuel, girada 180°, em tom Silver Oak e com o relevo realçado) até a Belgotex enviar o macro oficial.
import detailImg from '../assets/details/textura-sincronizada.jpg';
const items = [
  {
    id: 'close-canyon',
    caption: 'Canyon Oak · veio e relevo sincronizados',
    alt: 'Close do padrão Canyon Oak mostrando veios de carvalho dourado',
  },
  {
    id: 'close-harmony-hb',
    caption: 'Harmony Oak · encontro das réguas em espinha de peixe',
    alt: 'Close das réguas de Harmony Oak encaixadas em espinha de peixe',
  },
  {
    id: 'close-pacific',
    caption: 'Pacific Oak · acabamento fosco Xtra Matte',
    alt: 'Close do padrão Pacific Oak, carvalho escuro com acabamento fosco',
  },
  {
    id: 'close-silver',
    caption: 'Silver Oak · carvalho acinzentado',
    alt: 'Close do padrão Silver Oak, carvalho em tom cinza claro',
  },
];
---

<section id="texturas" class="section textures" data-section-id="textures" aria-labelledby="texturas-title">
  <div class="container">
    <div class="section-head">
      <h2 id="texturas-title">Veja de perto</h2>
      <p class="lead">
        A textura sincronizada acompanha o desenho de cada veio, e o acabamento fosco tira o brilho de
        plástico. Na mão e no pé, parece madeira.
      </p>
    </div>
    <ul class="grid">
      {items.map((it) => (
        <li>
          <figure class="tile">
            <span class="tile-media">
              <Picture
                src={closeupImages[it.id]!}
                formats={['avif', 'webp']}
                widths={[360, 600, 900]}
                sizes="(min-width: 1024px) 290px, 50vw"
                alt={it.alt}
                loading="lazy"
                quality={74}
              />
              <span class="tile-light" aria-hidden="true"></span>
            </span>
            <figcaption class="small muted">{it.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <figure class="detail" data-detail>
      <div class="detail-media">
        <Picture
          src={detailImg}
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1600, 2000]}
          sizes="(min-width: 1280px) 1200px, 100vw"
          alt="Close em luz rasante do relevo da madeira: os sulcos acompanham os veios e o nó do carvalho"
          loading="lazy"
          quality={74}
        />
        <span class="detail-light" aria-hidden="true"></span>
      </div>
      <figcaption class="detail-cap">
        <span class="eyebrow detail-eyebrow">Textura sincronizada</span>
        <span class="detail-title">Sinta cada detalhe.</span>
        <span class="detail-text">O relevo acompanha exatamente o desenho de cada veio.</span>
      </figcaption>
    </figure>
  </div>
</section>
<style>
  .textures {
    padding-top: 0;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--col-gap);
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  figure {
    margin: 0;
    display: grid;
    gap: 0.625rem;
  }
  .grid figure :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  /* Mouse over: aproxima a textura, uma luz rasante atravessa o close e a legenda ganha contraste */
  .tile-media {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 2px;
  }
  .tile-light {
    position: absolute;
    inset: -10% -60%;
    background: linear-gradient(100deg, transparent 40%, rgba(255, 240, 214, 0.32) 50%, transparent 60%);
    mix-blend-mode: soft-light;
    transform: translateX(-70%);
    opacity: 0;
    pointer-events: none;
  }
  .tile figcaption {
    position: relative;
    padding-top: 0.5rem;
    transition: color 0.35s ease;
  }
  .tile figcaption::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .tile:hover figcaption {
      color: var(--ink);
    }
    .tile:hover figcaption::before {
      transform: scaleX(1);
    }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .tile-media :global(img) {
      transition:
        transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1),
        filter 0.6s ease;
    }
    .tile:hover .tile-media :global(img) {
      transform: scale(1.07);
      filter: contrast(1.06) saturate(1.08);
    }
    .tile:hover .tile-light {
      opacity: 1;
      transform: translateX(70%);
      transition:
        transform 1.2s cubic-bezier(0.45, 0, 0.25, 1),
        opacity 0.2s ease;
    }
  }

  /* Close do relevo: faixa larga com texto sobre a foto */
  .detail {
    position: relative;
    display: block;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    overflow: hidden;
    border-radius: var(--radius);
    background: #2a2826;
    color: #fff;
  }
  .detail-media {
    position: relative;
    aspect-ratio: 2.35 / 1;
    min-height: 320px;
    overflow: hidden;
  }
  @media (max-width: 599px) {
    .detail-media {
      min-height: 400px;
    }
  }
  .detail-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 50%;
  }
  .detail-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(30, 28, 26, 0.74) 0%, rgba(30, 28, 26, 0.22) 38%, rgba(30, 28, 26, 0) 60%),
      linear-gradient(90deg, rgba(30, 28, 26, 0.38) 0%, rgba(30, 28, 26, 0) 50%);
    pointer-events: none;
  }
  .detail-cap {
    position: absolute;
    left: clamp(1.25rem, 1rem + 2vw, 2.75rem);
    right: clamp(1.25rem, 1rem + 2vw, 2.75rem);
    bottom: clamp(1.25rem, 1rem + 2vw, 2.5rem);
    z-index: 1;
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }
  .detail-eyebrow {
    color: rgba(255, 255, 255, 0.85);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .detail-eyebrow::before {
    content: '';
    width: 2.5rem;
    height: 1px;
    background: currentColor;
  }
  .detail-title {
    text-shadow: 0 1px 18px rgba(20, 18, 16, 0.4);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .detail-text {
    color: rgba(255, 255, 255, 0.85);
    max-width: 40ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Profundidade: a foto corre mais devagar que a página (parallax na rolagem), dentro de uma margem
       ampliada do quadro */
    .detail-media :global(picture) {
      display: block;
      height: 100%;
      transform: translate3d(0, var(--py, 0%), 0) scale(1.14);
      will-change: transform;
    }
    /* Aproximação lenta ao entrar na tela + uma faixa de luz rasante que atravessa o relevo */
    .detail-media :global(img) {
      transform: scale(1.08);
      transition: transform 2.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .detail.in .detail-media :global(img) {
      transform: scale(1);
    }
    .detail-light {
      position: absolute;
      inset: -20% -40%;
      background: linear-gradient(100deg, transparent 40%, rgba(255, 250, 240, 0.3) 50%, transparent 60%);
      mix-blend-mode: soft-light;
      transform: translateX(-60%);
      pointer-events: none;
    }
    .detail.in .detail-light {
      animation: graze 3.2s cubic-bezier(0.45, 0, 0.25, 1) 0.4s both;
    }
    @keyframes graze {
      to {
        transform: translateX(60%);
      }
    }
    .detail-cap > * {
      transition:
        opacity 0.7s ease,
        transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .detail[data-wait] .detail-cap > * {
      transform: translateY(12px);
    }
    .detail-cap > :nth-child(2) {
      transition-delay: 0.1s;
    }
    .detail-cap > :nth-child(3) {
      transition-delay: 0.2s;
    }
  }
</style>

<script>
  const detail = document.querySelector<HTMLElement>('[data-detail]');
  if (detail) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e!.isIntersecting) {
          detail.dataset.wait = '';
          return;
        }
        delete detail.dataset.wait;
        detail.classList.add('in');
        io.disconnect();
      },
      { threshold: 0.3 },
    );
    io.observe(detail);

    // Parallax da foto do relevo: -5% a 5% da altura conforme o quadro atravessa a tela
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const media = detail.querySelector<HTMLElement>('.detail-media')!;
      let raf = 0;
      const update = () => {
        raf = 0;
        const r = detail.getBoundingClientRect();
        const vh = window.innerHeight;
        if (r.bottom < 0 || r.top > vh) return;
        const p = Math.max(-1, Math.min(1, (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2)));
        media.style.setProperty('--py', `${(p * 5).toFixed(2)}%`);
      };
      const onScroll = () => {
        if (!raf) raf = requestAnimationFrame(update);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    }
  }
</script>
