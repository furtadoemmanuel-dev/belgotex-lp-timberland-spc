# Copie para .env e ajuste. Todas são lidas no build (nada aqui é segredo exposto, exceto se indicado).

# Número do WhatsApp com DDI + DDD (somente dígitos). Mesmo número em uso em belgotex.com.br.
WHATSAPP_NUMBER=554291391436

# Código da campanha incluído na mensagem do WhatsApp e no lead, para filtrar no atendimento.
CAMPAIGN_CODE=LP-TIMBERLAND-SPC

# Destino do formulário. Vazio = modo simulado (nenhum dado sai do navegador). Ver docs/integration-rd.md.
LEAD_ENDPOINT=

# Simulador "Ver no meu ambiente". Enquanto a Roomvo não liberar o subdomínio, aponta para a página do produto.
SIMULATOR_URL=https://www.belgotex.com.br/produtos/pisos-vinilicos-lvt/timberland

# Política de privacidade e de cookies da Belgotex.
PRIVACY_URL=https://www.belgotex.com.br/politica-de-privacidade
COOKIES_URL=https://www.belgotex.com.br/politica-de-cookies

# Google Tag Manager (o mesmo container do site principal, se a Belgotex confirmar). Vazio = sem GTM.
GTM_ID=

# Endereço final da LP (canonical, sitemap, Open Graph).
SITE_URL=https://timberland.belgotex.com.br
